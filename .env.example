# Copy to .env for local development with `netlify dev`.
# In production, set these in the Netlify UI:
#   Site configuration -> Environment variables
# NEVER commit real values.

# Shared access password handed to customers (choose a strong passphrase).
PORTAL_PASSWORD=change-me

# Long random secret used to sign session cookies (32+ random chars).
# Generate one with:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# OPTIONAL. Session generation / revocation knob. Bump this (e.g. 1 -> 2) to
# instantly invalidate every issued login on this site without rotating
# SESSION_SECRET. Defaults to "1" when unset.
SESSION_VERSION=1

# OPTIONAL. Enables comment moderation. When set, staff can enter this password
# in the comments widget ("Moderate") to delete any comment. Leave unset to
# disable deletion entirely. Use a DIFFERENT value from PORTAL_PASSWORD.
ADMIN_PASSWORD=change-me-to-an-admin-only-password
