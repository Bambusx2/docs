---
/**
 * Head override — enables Astro client-side routing (view transitions).
 *
 * Starlight is a multi-page app by default, so every link does a full browser
 * reload: the stylesheet and web font are re-applied from scratch, which the
 * eye sees as the whole page "blinking" / re-styling on each navigation.
 *
 * <ClientRouter /> turns navigations into in-place DOM swaps — CSS and fonts
 * stay loaded, so there's no flash. The inline script below re-applies the
 * saved Starlight theme immediately after each swap (and before paint) so the
 * theme never flickers back to the default mid-transition.
 */
import Default from '@astrojs/starlight/components/Head.astro';
import { ClientRouter } from 'astro:transitions';
---

<Default><slot /></Default>
<ClientRouter />

<script>
  // Render Mermaid diagrams client-side. The remark plugin emits each diagram
  // as <pre class="mermaid" data-mermaid-source="…">; here we turn those into
  // SVG. Runs on initial load and after every view transition. securityLevel
  // 'strict' disables any HTML/JS embedded in diagram text.
  //
  // Mermaid (~1MB) is dynamically imported ONLY on pages that actually contain
  // a diagram, so diagram-free pages never download it.

  function currentTheme() {
    return document.documentElement.dataset.theme === 'light' ? 'default' : 'dark';
  }

  async function renderMermaid() {
    const nodes = document.querySelectorAll('pre.mermaid:not([data-rendered])');
    if (!nodes.length) return;
    const { default: mermaid } = await import('mermaid');
    // suppressErrorRendering: don't let Mermaid inject its "Syntax error" graphic
    // into the page; we handle failures ourselves below.
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      suppressErrorRendering: true,
      theme: currentTheme(),
    });
    let n = 0;
    for (const el of nodes) {
      const source = el.getAttribute('data-mermaid-source') || el.textContent || '';
      el.setAttribute('data-rendered', 'true');
      try {
        const { svg } = await mermaid.render(`mmd-${Date.now()}-${n++}`, source);
        el.innerHTML = svg;
      } catch {
        // Fall back to the raw source in a code block rather than an error graphic.
        el.classList.add('mermaid-error');
        el.textContent = source;
      }
    }
  }

  renderMermaid();
  document.addEventListener('astro:page-load', renderMermaid);
</script>

<script is:inline>
  document.addEventListener('astro:after-swap', () => {
    const stored =
      typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
    const theme =
      stored ||
      (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
  });

  /*
   * Keep the left sidebar scrolled to where the reader left it.
   *
   * Starlight persists sidebar scroll only on the `pageHide` /
   * `visibilitychange` events, which never fire during <ClientRouter />
   * navigations (they are in-place DOM swaps). So we capture the scroll
   * position ourselves right before each swap and re-apply it right after,
   * once the new sidebar is in the DOM.
   */
  var SIDEBAR_SCROLL_KEY = 'sl-sidebar-scrolltop';
  document.addEventListener('astro:before-swap', () => {
    const sb = document.getElementById('starlight__sidebar');
    if (sb) sessionStorage.setItem(SIDEBAR_SCROLL_KEY, String(sb.scrollTop));
  });
  document.addEventListener('astro:after-swap', () => {
    const sb = document.getElementById('starlight__sidebar');
    const y = sessionStorage.getItem(SIDEBAR_SCROLL_KEY);
    if (sb && y !== null) sb.scrollTop = parseInt(y, 10) || 0;
  });
</script>
