---
/**
 * Head override — enables Astro client-side routing (view transitions).
 *
 * Starlight is a multi-page app by default, so every link does a full browser
 * reload: the stylesheet and web font are re-applied from scratch, which the
 * eye sees as the whole page "blinking" / re-styling on each navigation.
 *
 * <ClientRouter /> turns navigations into in-place DOM swaps — CSS and fonts
 * stay loaded, so there's no flash. The inline script below re-applies the
 * saved Starlight theme immediately after each swap (and before paint) so the
 * theme never flickers back to the default mid-transition.
 */
import Default from '@astrojs/starlight/components/Head.astro';
import { ClientRouter } from 'astro:transitions';
---

<Default><slot /></Default>
<ClientRouter />

<script>
  // Render Mermaid diagrams client-side. The remark plugin emits each diagram
  // as <pre class="mermaid" data-mermaid-source="…">; here we turn those into
  // SVG. Runs on initial load and after every view transition. securityLevel
  // 'strict' disables any HTML/JS embedded in diagram text.
  //
  // Mermaid (~1MB) is dynamically imported ONLY on pages that actually contain
  // a diagram, so diagram-free pages never download it.

  function currentTheme() {
    return document.documentElement.dataset.theme === 'light' ? 'default' : 'dark';
  }

  async function renderMermaid() {
    const nodes = document.querySelectorAll('pre.mermaid:not([data-rendered])');
    if (!nodes.length) return;
    const { default: mermaid } = await import('mermaid');
    // suppressErrorRendering: don't let Mermaid inject its "Syntax error" graphic
    // into the page; we handle failures ourselves below.
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      suppressErrorRendering: true,
      theme: currentTheme(),
    });
    let n = 0;
    for (const el of nodes) {
      const source = el.getAttribute('data-mermaid-source') || el.textContent || '';
      el.setAttribute('data-rendered', 'true');
      try {
        const { svg } = await mermaid.render(`mmd-${Date.now()}-${n++}`, source);
        el.innerHTML = svg;
      } catch {
        // Fall back to the raw source in a code block rather than an error graphic.
        el.classList.add('mermaid-error');
        el.textContent = source;
      }
    }
  }

  renderMermaid();
  document.addEventListener('astro:page-load', renderMermaid);

  // ---- Collapsible panels: header toggles for the left nav and right TOC ----
  // State lives on <html> (data-hide-nav / data-hide-toc) + localStorage; the
  // inline head script applies it before paint. Buttons are injected into the
  // header's desktop control group and re-injected after view transitions.
  const PANEL_ICONS = {
    nav: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg>',
    toc: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="15" y1="3" x2="15" y2="21"/></svg>',
  };
  const PANEL_DEFS = [
    { target: 'nav', key: 'neopix-hide-nav', label: 'Hide navigation sidebar' },
    { target: 'toc', key: 'neopix-hide-toc', label: 'Hide page outline' },
  ];
  function injectPanelToggles() {
    const group = document.querySelector('.right-group');
    if (!group || group.querySelector('.neopix-panel-toggle')) return;
    const root = document.documentElement;
    for (const d of PANEL_DEFS) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'neopix-panel-toggle';
      btn.dataset.target = d.target;
      btn.title = d.label;
      btn.setAttribute('aria-label', d.label);
      btn.innerHTML = PANEL_ICONS[d.target];
      const sync = () =>
        btn.setAttribute('aria-pressed', root.hasAttribute('data-hide-' + d.target) ? 'true' : 'false');
      sync();
      btn.addEventListener('click', () => {
        const attr = 'data-hide-' + d.target;
        const hide = !root.hasAttribute(attr);
        root.toggleAttribute(attr, hide);
        try {
          hide ? localStorage.setItem(d.key, '1') : localStorage.removeItem(d.key);
        } catch (e) {}
        sync();
      });
      group.insertBefore(btn, group.firstChild);
    }
  }
  injectPanelToggles();
  document.addEventListener('astro:page-load', injectPanelToggles);
</script>

<script is:inline>
  /*
   * Apply saved panel-collapse preferences BEFORE paint, so a hidden nav/TOC
   * never flashes in. State lives on <html> (data-hide-nav / data-hide-toc)
   * and is re-applied after each view-transition swap (attributes reset then).
   */
  function applyPanelPrefs() {
    try {
      var r = document.documentElement;
      r.toggleAttribute('data-hide-nav', localStorage.getItem('neopix-hide-nav') === '1');
      r.toggleAttribute('data-hide-toc', localStorage.getItem('neopix-hide-toc') === '1');
    } catch (e) {}
  }
  applyPanelPrefs();
  document.addEventListener('astro:after-swap', applyPanelPrefs);

  document.addEventListener('astro:after-swap', () => {
    const stored =
      typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
    const theme =
      stored ||
      (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
  });

  /*
   * Keep the left sidebar scrolled to where the reader left it.
   *
   * Starlight persists sidebar scroll only on the `pageHide` /
   * `visibilitychange` events, which never fire during <ClientRouter />
   * navigations (they are in-place DOM swaps). So we capture the scroll
   * position ourselves right before each swap and re-apply it right after,
   * once the new sidebar is in the DOM.
   */
  var SIDEBAR_SCROLL_KEY = 'sl-sidebar-scrolltop';
  document.addEventListener('astro:before-swap', () => {
    const sb = document.getElementById('starlight__sidebar');
    if (sb) sessionStorage.setItem(SIDEBAR_SCROLL_KEY, String(sb.scrollTop));
  });
  document.addEventListener('astro:after-swap', () => {
    const sb = document.getElementById('starlight__sidebar');
    const y = sessionStorage.getItem(SIDEBAR_SCROLL_KEY);
    if (sb && y !== null) sb.scrollTop = parseInt(y, 10) || 0;
  });
</script>
