---
/**
 * SiteTitle override — renders the Ingsoftware "ing" mark as an INLINE SVG.
 *
 * Why inline rather than Starlight's default <img>: the default renders the
 * logo as an external SVG file (two of them, for light/dark). On every page
 * navigation (Starlight is a full-reload MPA) the browser re-fetches and
 * re-decodes that file, which makes the logo visibly blink. An inline SVG
 * paints together with the HTML — no extra request, no flash — and a single
 * `currentColor` fill adapts to both themes, so there's no light/dark image
 * swap either.
 */
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
  <svg
    class="site-logo"
    width="53"
    height="28"
    viewBox="0 0 53 28"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M0 1.90998C0 1.36182 0.17335 0.905795 0.516928 0.543477C0.862067 0.181159 1.35557 0 1.99743 0C2.6393 0 3.13436 0.181159 3.48419 0.543477C3.83401 0.905795 4.00892 1.36182 4.00892 1.90998C4.00892 2.45814 3.83401 2.89698 3.48419 3.25462C3.13436 3.61225 2.6393 3.79028 1.99743 3.79028C1.35557 3.79028 0.862067 3.61225 0.51849 3.25462C0.17335 2.89698 0 2.44877 0 1.90998ZM3.76061 21.7906H0.21864V6.02041H3.76061V21.7906Z"/>
    <path d="M10.9018 6.01997L11.0034 7.84249C12.17 6.43383 13.7004 5.72949 15.5948 5.72949C18.8791 5.72949 20.5501 7.6098 20.6095 11.3704V21.7917H17.0675V11.5734C17.0675 10.5724 16.852 9.83212 16.4194 9.35111C15.9868 8.8701 15.2793 8.6296 14.2986 8.6296C12.8696 8.6296 11.8061 9.27615 11.1064 10.5677V21.7917H7.56445V6.01997H10.9018Z"/>
    <path d="M23.5973 13.7881C23.5973 11.3394 24.1735 9.3841 25.3245 7.92077C26.4755 6.45901 28.0044 5.72656 29.9082 5.72656C31.7057 5.72656 33.119 6.35281 34.1498 7.60687L34.3106 6.0186H37.5028V21.3078C37.5028 23.3771 36.8594 25.0106 35.5709 26.2053C34.2825 27.4001 32.5459 27.9982 30.3595 27.9982C29.2023 27.9982 28.0731 27.7577 26.9706 27.2767C25.868 26.7957 25.0294 26.1663 24.4562 25.3886L26.1319 23.2599C27.2204 24.5515 28.5604 25.198 30.1549 25.198C31.3309 25.198 32.2585 24.8794 32.9394 24.2438C33.6188 23.6066 33.9592 22.6727 33.9592 21.4374V20.3739C32.9394 21.5108 31.5776 22.0793 29.8785 22.0793C28.0325 22.0793 26.5239 21.3453 25.3526 19.8788C24.1813 18.4124 23.5957 16.3806 23.5957 13.7866L23.5973 13.7881ZM27.1252 14.0942C27.1252 15.6778 27.4485 16.9241 28.095 17.833C28.7416 18.7419 29.638 19.1964 30.7843 19.1964C32.2133 19.1964 33.2721 18.5842 33.9624 17.3598V10.4211C33.2924 9.22637 32.2429 8.62823 30.814 8.62823C29.6474 8.62823 28.7416 9.0905 28.095 10.0135C27.4485 10.9364 27.1252 12.2967 27.1252 14.0942Z"/>
    <path d="M52.1822 23.2637H39.3418V21.791H52.1822V23.2637Z"/>
  </svg>
  <span class="sr-only" translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: var(--sl-nav-gap);
    color: var(--sl-color-white); /* light on dark theme, navy on light theme */
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  .site-logo {
    height: 1.6rem;
    width: auto;
    display: block;
  }
</style>
