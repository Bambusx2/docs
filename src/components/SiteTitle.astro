---
/**
 * SiteTitle override — renders the Neopix wordmark as inline text.
 *
 * Neopix's brand mark is a minimalist lowercase "neopix" wordmark. Rendering it
 * as inline text (rather than Starlight's default external <img> logo) means:
 *  - no extra request and no logo "blink" on client-side navigation, and
 *  - a single `currentColor`-driven color that adapts to light/dark themes,
 *    so there's no separate light/dark logo asset to swap.
 */
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
  <span class="site-wordmark" translate="no" aria-hidden="true">neopix</span>
  <span class="sr-only" translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: var(--sl-nav-gap);
    color: var(--sl-color-white); /* light on dark theme, navy on light theme */
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  .site-wordmark {
    font-weight: 800;
    font-size: 1.4rem;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--sl-color-white);
  }
</style>
